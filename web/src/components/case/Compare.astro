---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../../i18n/routes';
import { uiT } from '../../i18n/ui';

interface Props {
  lang: Lang;
  before: ImageMetadata | string;
  after: ImageMetadata | string;
  altBefore: string;
  altAfter: string;
  eager?: boolean;
  caption?: string;
}

const { lang, before, after, altBefore, altAfter, eager = false, caption } = Astro.props;
const beforeSrc = typeof before === 'string' ? before : before.src;
const afterSrc = typeof after === 'string' ? after : after.src;
const beforeW = typeof before === 'string' ? undefined : before.width;
const beforeH = typeof before === 'string' ? undefined : before.height;
const widths = [480, 960, 1440, 2160];
const sizes = '(min-width: 768px) 50vw, 100vw';
const frame = 'absolute inset-0 h-full w-full object-cover object-top';
---

<figure class="gubia-compare-figure">
  <gubia-compare
    class="gubia-compare block relative overflow-hidden rounded-[var(--radius-md)] border border-linea bg-blanco"
    data-label-before={uiT('compare.before', lang)}
    data-label-after={uiT('compare.after', lang)}
  >
    <div class="compare-stack relative aspect-[16/9] w-full">
      {
        typeof before === 'string' ? (
          <img
            src={beforeSrc}
            alt={altBefore}
            width={beforeW}
            height={beforeH}
            class={frame}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
          />
        ) : (
          <Picture
            src={before}
            alt={altBefore}
            widths={widths}
            sizes={sizes}
            formats={['avif', 'webp']}
            class={frame}
            pictureAttributes={{ class: 'absolute inset-0 block h-full w-full' }}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
          />
        )
      }
      <div data-compare-after class="absolute inset-0" style="clip-path: inset(0 0 0 50%)">
        {
          typeof after === 'string' ? (
            <img
              src={afterSrc}
              alt={altAfter}
              width={beforeW}
              height={beforeH}
              class={frame}
              loading={eager ? 'eager' : 'lazy'}
              fetchpriority={eager ? 'high' : undefined}
              decoding="async"
            />
          ) : (
            <Picture
              src={after}
              alt={altAfter}
              widths={widths}
              sizes={sizes}
              formats={['avif', 'webp']}
              class={frame}
              pictureAttributes={{ class: 'absolute inset-0 block h-full w-full' }}
              loading={eager ? 'eager' : 'lazy'}
              fetchpriority={eager ? 'high' : undefined}
              decoding="async"
            />
          )
        }
      </div>

      <span
        class="pointer-events-none absolute left-3 top-3 rounded-sm bg-gris px-2 py-0.5 text-xs font-semibold text-blanco"
      >
        {uiT('compare.before', lang)}
      </span>
      <span
        class="pointer-events-none absolute right-3 top-3 rounded-sm bg-verde px-2 py-0.5 text-xs font-semibold text-crema"
      >
        {uiT('compare.after', lang)}
      </span>

      <div
        data-compare-handle
        class="compare-handle pointer-events-none absolute top-0 bottom-0 left-1/2 z-10 w-0.5 -translate-x-1/2 bg-naranja"
        aria-hidden="true"
      >
        <span
          class="absolute top-1/2 left-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-naranja bg-crema text-tinta shadow-[var(--shadow-soft)]"
        >
          <span class="text-sm font-bold" aria-hidden="true">↔</span>
        </span>
      </div>

      <input
        data-compare-range
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label={uiT('compare.label', lang)}
        class="absolute inset-0 z-20 m-0 h-full w-full cursor-ew-resize appearance-none bg-transparent opacity-0"
      />
    </div>

    <!-- Fallback layout without JS: side-by-side via CSS when not enhanced -->
    <noscript>
      <div class="grid gap-2 p-2 md:grid-cols-2">
        <div>
          <p class="mb-1 text-xs font-semibold text-gris">{uiT('compare.before', lang)}</p>
          <img src={beforeSrc} alt={altBefore} class="w-full rounded" />
        </div>
        <div>
          <p class="mb-1 text-xs font-semibold text-verde">{uiT('compare.after', lang)}</p>
          <img src={afterSrc} alt={altAfter} class="w-full rounded" />
        </div>
      </div>
    </noscript>
  </gubia-compare>
  {caption && <figcaption class="mt-2 text-sm text-gris">{caption}</figcaption>}
</figure>

<style>
  gubia-compare:not(.is-enhanced) .compare-handle {
    display: none;
  }
  gubia-compare:not(.is-enhanced) [data-compare-range] {
    display: none;
  }
  gubia-compare:not(.is-enhanced) [data-compare-after] {
    clip-path: none !important;
    position: static !important;
  }
  gubia-compare:not(.is-enhanced) .compare-stack {
    display: grid;
    grid-template-columns: 1fr;
    aspect-ratio: auto;
    gap: 0.5rem;
  }
  gubia-compare:not(.is-enhanced) .compare-stack > img,
  gubia-compare:not(.is-enhanced) .compare-stack > picture,
  gubia-compare:not(.is-enhanced) [data-compare-after] picture,
  gubia-compare:not(.is-enhanced) [data-compare-after] img {
    position: static !important;
    height: auto;
  }
  @media (min-width: 768px) {
    gubia-compare:not(.is-enhanced) .compare-stack {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  import '../../scripts/compare';
</script>
