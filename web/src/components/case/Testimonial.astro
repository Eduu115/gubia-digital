---
interface Props {
  autor: string;
  cargo: string;
  texto: string;
  translated?: boolean;
  translatedLabel?: string;
}

const { autor, cargo, texto, translated = false, translatedLabel = '' } = Astro.props;
---

<figure class="border-l-4 border-naranja bg-blanco px-6 py-5">
  <blockquote>
    <p class="font-display text-xl text-tinta">“{texto}”</p>
  </blockquote>
  <figcaption class="mt-3 text-sm text-gris">
    {autor}, {cargo}
    {translated && translatedLabel && <span> {translatedLabel}</span>}
  </figcaption>
</figure>
