---
import { getCollection } from 'astro:content';
import CompareGroup from '../case/CompareGroup.astro';
import { resolveContentImage } from '../../lib/images';
import type { Lang } from '../../i18n/routes';

interface Props {
  id: string;
  caso: string;
  lang: Lang;
}

const { id, caso, lang } = Astro.props;
const entries = await getCollection('casos');
const entry = entries.find((item) => item.id.split('/')[0] === caso);
const matches = (entry?.data.comparativas ?? []).filter((item) => item.id === id);

if (!entry || matches.length === 0) {
  throw new Error(`Comparativa "${id}" no existe en el caso "${caso}"`);
}

const pairs = matches.flatMap((item) => {
  const before = resolveContentImage('casos', caso, item.antes);
  const after = resolveContentImage('casos', caso, item.despues);
  if (!before || !after) return [];
  return [
    {
      id: item.id,
      dispositivo: item.dispositivo,
      before,
      after,
      altBefore: item.alt.antes[lang],
      altAfter: item.alt.despues[lang],
      caption: item.pie?.[lang],
    },
  ];
});

if (pairs.length === 0) {
  throw new Error(`Comparativa "${id}" del caso "${caso}" no tiene imágenes resolubles`);
}
---

<CompareGroup lang={lang} pairs={pairs} />
