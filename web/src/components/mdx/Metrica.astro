---
import { getCollection } from 'astro:content';
import MetricDelta from '../case/MetricDelta.astro';
import { resolveMetric } from '../../lib/content';
import type { Lang } from '../../i18n/routes';

interface Props {
  id: string;
  caso: string;
  lang: Lang;
}

const { id, caso, lang } = Astro.props;
const entries = await getCollection('casos');
const entry = entries.find((item) => item.id.split('/')[0] === caso);
const metrica = (entry?.data.metricas ?? []).find((item) => (item.id ?? item.clave) === id);

if (!entry || !metrica) {
  throw new Error(`Metrica "${id}" no existe en el caso "${caso}"`);
}

const meta = resolveMetric(metrica, lang);
---

<MetricDelta
  lang={lang}
  label={meta.label}
  before={metrica.antes}
  after={metrica.despues}
  unit={meta.unidad}
  mejor={meta.mejor}
  fuente={metrica.fuente}
  fechaAntes={metrica.fechaAntes}
  fechaDespues={metrica.fechaDespues}
/>
