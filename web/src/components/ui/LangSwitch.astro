---
import type { Lang, RouteKey } from '../../i18n/routes';
import { localizedPath, alternateLang } from '../../i18n/utils';
import { uiT } from '../../i18n/ui';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  slug?: string;
  alternateHref?: string;
}

const { lang, routeKey, slug, alternateHref } = Astro.props;
const other = alternateLang(lang);
const href =
  alternateHref ??
  (slug ? localizedPath(routeKey, other, { slug }) : localizedPath(routeKey, other));
const here =
  Astro.url.pathname === '/404' || Astro.url.pathname === '/404/'
    ? localizedPath(routeKey, lang)
    : Astro.url.pathname;
---

<div class="flex items-center gap-1 text-sm font-semibold" role="group" aria-label={uiT('lang.label', lang)}>
  <a
    href={lang === 'es' ? here : href}
    class:list={[
      'rounded px-1.5 py-0.5',
      lang === 'es' ? 'bg-naranja text-tinta' : 'text-crema/80 hover:text-blanco',
    ]}
    aria-current={lang === 'es' ? 'true' : undefined}
    hreflang="es"
  >
    {uiT('lang.es', lang)}
  </a>
  <span class="text-crema/40" aria-hidden="true">/</span>
  <a
    href={lang === 'en' ? here : href}
    class:list={[
      'rounded px-1.5 py-0.5',
      lang === 'en' ? 'bg-naranja text-tinta' : 'text-crema/80 hover:text-blanco',
    ]}
    aria-current={lang === 'en' ? 'true' : undefined}
    hreflang="en"
  >
    {uiT('lang.en', lang)}
  </a>
</div>
