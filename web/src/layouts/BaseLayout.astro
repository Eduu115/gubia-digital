---
import '../styles/global.css';
import type { Lang } from '../i18n/routes';
import { localizedPath } from '../i18n/utils';
import { uiT } from '../i18n/ui';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogImage?: string;
  routeKey?: import('../i18n/routes').RouteKey;
  slug?: string;
  alternateHref?: string;
  noindex?: boolean;
  pathOverride?: string;
}

const {
  lang,
  title,
  description,
  ogImage = '/og-default.webp',
  routeKey = 'home',
  slug,
  alternateHref,
  noindex = false,
  pathOverride,
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://gubiadigital.example');
const canonicalPath =
  pathOverride ?? (slug ? localizedPath(routeKey, lang, { slug }) : localizedPath(routeKey, lang));
const canonical = new URL(canonicalPath, siteUrl).href;
const altEs = pathOverride
  ? lang === 'es'
    ? pathOverride
    : (alternateHref ?? pathOverride)
  : slug
    ? localizedPath(routeKey, 'es', { slug })
    : localizedPath(routeKey, 'es');
const altEn = pathOverride
  ? lang === 'en'
    ? pathOverride
    : (alternateHref ?? pathOverride)
  : slug
    ? localizedPath(routeKey, 'en', { slug })
    : localizedPath(routeKey, 'en');
const fullTitle = `${title} · Gubia Digital`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(altEs, siteUrl).href} />
    <link rel="alternate" hreflang="en" href={new URL(altEn, siteUrl).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(altEs, siteUrl).href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class="min-h-[100dvh] flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[var(--radius-md)] focus:bg-naranja focus:px-4 focus:py-2 focus:text-tinta focus:font-semibold"
    >
      {uiT('skip', lang)}
    </a>
    <Header lang={lang} routeKey={routeKey} slug={slug} alternateHref={alternateHref} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
