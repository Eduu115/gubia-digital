---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import CompareGroup from '../components/case/CompareGroup.astro';
import MetricDelta from '../components/case/MetricDelta.astro';
import StartingPoint from '../components/case/StartingPoint.astro';
import Testimonial from '../components/case/Testimonial.astro';
import Button from '../components/ui/Button.astro';
import Chip from '../components/ui/Chip.astro';
import Comparativa from '../components/mdx/Comparativa.astro';
import Captura from '../components/mdx/Captura.astro';
import Metrica from '../components/mdx/Metrica.astro';
import Nota from '../components/mdx/Nota.astro';
import type { Lang } from '../i18n/routes';
import { uiT } from '../i18n/ui';
import { localizedPath, formatMonth } from '../i18n/utils';
import {
  getCasoEntry,
  getCasoTexto,
  resolveMetric,
} from '../lib/content';
import { resolveContentImage, resolveContentPdf } from '../lib/images';
import { render } from 'astro:content';
import JsonLd from '../components/seo/JsonLd.astro';
import { breadcrumbList, creativeWork } from '../lib/schema';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const entry = await getCasoEntry(slug);
if (!entry) {
  return Astro.redirect(localizedPath('casos', lang));
}

const texto = await getCasoTexto(slug, lang);
if (!texto) {
  return Astro.redirect(localizedPath('casos', lang));
}

const { Content } = await render(texto);
const cliente = entry.data.anonimo
  ? entry.data.clienteAnonimo?.[lang] ?? entry.data.cliente
  : entry.data.cliente;

const pairs = (entry.data.comparativas ?? []).flatMap((item) => {
  const before = resolveContentImage('casos', slug, item.antes);
  const after = resolveContentImage('casos', slug, item.despues);
  if (!before || !after) return [];
  return [
    {
      id: item.id,
      dispositivo: item.dispositivo,
      before,
      after,
      altBefore: item.alt.antes[lang],
      altAfter: item.alt.despues[lang],
      caption: item.pie?.[lang],
    },
  ];
});
const leadId = pairs[0]?.id;
const leadPairs = leadId ? pairs.filter((pair) => pair.id === leadId) : [];
const partida = entry.data.puntoDePartida;
const informe = entry.data.informes?.[lang] ?? entry.data.informes?.es;
const informeUrl = informe ? resolveContentPdf('casos', slug, informe) : undefined;
const origin = Astro.site ?? new URL('https://gubiadigital.example');
const pageUrl = new URL(localizedPath('caso', lang, { slug }), origin).href;
const casosUrl = new URL(localizedPath('casos', lang), origin).href;
const ogPath = slug.startsWith('_') ? '/og-default.webp' : `/og/casos/${slug}.webp`;
const ogImage = new URL(ogPath, origin).href;
const partidaImg = partida.imagen ? resolveContentImage('casos', slug, partida.imagen) : undefined;
const mdxComponents = { Comparativa, Captura, Metrica, Nota };
---

<BaseLayout
  lang={lang}
  title={texto.data.titulo}
  description={texto.data.descripcionSeo}
  routeKey="caso"
  slug={slug}
  ogImage={ogPath}
  ogWidth={slug.startsWith('_') ? undefined : 1200}
  ogHeight={slug.startsWith('_') ? undefined : 630}
>
  <JsonLd
    data={breadcrumbList([
      { name: uiT('nav.casos', lang), url: casosUrl },
      { name: cliente, url: pageUrl },
    ])}
  />
  <JsonLd
    data={creativeWork({
      name: texto.data.titulo,
      url: pageUrl,
      description: texto.data.descripcionSeo,
      image: ogImage,
    })}
  />
  <Section>
    <nav class="text-sm text-gris" aria-label="breadcrumb">
      <a href={localizedPath('casos', lang)} class="hover:text-tinta">{uiT('nav.casos', lang)}</a>
      <span aria-hidden="true"> / </span>
      <span>{cliente}</span>
    </nav>
    <h1 class="mt-4 max-w-[20ch] font-display text-3xl font-bold text-balance md:text-5xl">
      {texto.data.titulo}
    </h1>
    <p class="mt-3 text-lg text-gris">
      {cliente} · {entry.data.ubicacion} · {formatMonth(entry.data.fecha, lang)}
    </p>

    <dl class="mt-8 grid gap-4 border-y border-linea py-6 text-sm sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <dt class="text-gris">{uiT(`sector.${entry.data.sector}`, lang)}</dt>
        <dd class="mt-1 flex flex-wrap gap-1.5 font-semibold">
          {entry.data.servicios.map((s) => (
            <Chip>{uiT(`servicio.${s}`, lang)}</Chip>
          ))}
        </dd>
      </div>
      {
        entry.data.stack && (
          <div>
            <dt class="text-gris">Stack</dt>
            <dd class="font-semibold">{entry.data.stack.join(', ')}</dd>
          </div>
        )
      }
      {
        entry.data.urlEnVivo && !entry.data.anonimo && (
          <div>
            <dt class="text-gris">{uiT('case.live', lang)}</dt>
            <dd>
              <a class="font-semibold text-verde underline" href={entry.data.urlEnVivo} rel="noopener">
                {entry.data.urlEnVivo.replace(/^https?:\/\//, '')}
              </a>
            </dd>
          </div>
        )
      }
    </dl>

    {
      entry.data.metricas && entry.data.metricas.length > 0 && (
        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {entry.data.metricas.map((m) => {
            const meta = resolveMetric(m, lang);
            return (
              <MetricDelta
                lang={lang}
                label={meta.label}
                before={m.antes}
                after={m.despues}
                unit={meta.unidad}
                mejor={meta.mejor}
                fuente={m.fuente}
                fechaAntes={m.fechaAntes}
                fechaDespues={m.fechaDespues}
              />
            );
          })}
        </div>
      )
    }

    {
      partida.tipo === 'web' && leadPairs.length > 0 && (
        <div class="mt-12">
          <CompareGroup lang={lang} pairs={leadPairs} eager />
        </div>
      )
    }
    {
      partida.tipo !== 'web' && (
        <div class="mt-12">
          <StartingPoint
            lang={lang}
            descripcion={partida.descripcion[lang]}
            image={partidaImg}
            alt={partida.altImagen?.[lang] ?? ''}
          />
        </div>
      )
    }

    <div
      class="mt-12 space-y-4 text-tinta/90 [&_h2]:mt-10 [&_h2]:max-w-prose [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_p]:max-w-prose [&_aside]:max-w-prose [&_li]:max-w-prose [&_figure]:my-8"
    >
      <Content components={mdxComponents} />
    </div>

    {
      entry.data.testimonio && entry.data.permisos.testimonio && (
        <div class="mt-12">
          <Testimonial
            autor={entry.data.testimonio.autor}
            cargo={entry.data.testimonio.cargo[lang]}
            texto={entry.data.testimonio.texto[lang]}
            translated={entry.data.testimonio.idiomaOriginal !== lang}
            translatedLabel={uiT('translated', lang)}
          />
        </div>
      )
    }

    {
      informeUrl && (
        <p class="mt-10">
          <a class="font-semibold text-verde underline" href={informeUrl}>
            {uiT('case.report', lang)}
          </a>
        </p>
      )
    }

    <div class="mt-14">
      <h2 class="font-display text-2xl font-bold">{uiT('case.cta', lang)}</h2>
      <div class="mt-4">
        <Button href={localizedPath('contacto', lang)} variant="primary">
          {uiT('nav.cta', lang)}
        </Button>
      </div>
    </div>
  </Section>

  <p
    id="gubia-ref"
    hidden
    data-msg={uiT('ref.banner', lang).replaceAll('{cliente}', cliente)}
    data-cta={uiT('ref.cta', lang)}
    data-close={uiT('ref.close', lang)}
    data-href={localizedPath('contacto', lang)}
  ></p>

  <script>
    (() => {
      const params = new URLSearchParams(location.search);
      if (params.get('ref') !== 'footer') return;
      const copy = document.getElementById('gubia-ref');
      if (!copy) return;
      try {
        if (sessionStorage.getItem('gubia-ref-closed') === '1') return;
      } catch {}
      const bar = document.createElement('div');
      bar.setAttribute('role', 'status');
      bar.className =
        'fixed bottom-0 inset-x-0 z-50 border-t border-linea bg-tinta text-crema px-4 py-3 text-sm flex flex-wrap items-center justify-between gap-3';
      const msg = document.createElement('p');
      msg.textContent = copy.dataset.msg ?? '';
      const actions = document.createElement('div');
      actions.className = 'flex gap-2';
      const link = document.createElement('a');
      link.className = 'rounded-md bg-naranja px-3 py-1.5 font-semibold text-tinta';
      link.href = copy.dataset.href ?? '/contacto/';
      link.textContent = copy.dataset.cta ?? '';
      const close = document.createElement('button');
      close.type = 'button';
      close.className = 'rounded-md border border-crema/30 px-3 py-1.5';
      close.textContent = copy.dataset.close ?? '';
      close.addEventListener('click', () => {
        bar.remove();
        try {
          sessionStorage.setItem('gubia-ref-closed', '1');
        } catch {}
      });
      actions.append(link, close);
      bar.append(msg, actions);
      document.body.appendChild(bar);
    })();
  </script>
</BaseLayout>
