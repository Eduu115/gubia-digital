---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import type { Lang } from '../i18n/routes';
import { uiT } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<BaseLayout lang={lang} title={uiT('gracias.title', lang)} description={uiT('gracias.body', lang)} routeKey="gracias">
  <Section>
    <h1 class="font-display text-4xl font-bold">{uiT('gracias.title', lang)}</h1>
    <p class="mt-4 max-w-prose text-gris">{uiT('gracias.body', lang)}</p>
    <div class="mt-8">
      <Button href={localizedPath('casos', lang)} variant="secondary">{uiT('casos.all', lang)}</Button>
    </div>
  </Section>
</BaseLayout>
