---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import { uiT } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const links = [
  { href: localizedPath('home', lang), label: lang === 'es' ? 'Inicio' : 'Home' },
  { href: localizedPath('casos', lang), label: uiT('nav.casos', lang) },
  { href: localizedPath('proyectos', lang), label: uiT('nav.proyectos', lang) },
  { href: localizedPath('nosotros', lang), label: uiT('nav.nosotros', lang) },
  { href: localizedPath('contacto', lang), label: uiT('nav.contacto', lang) },
];
---

<BaseLayout lang={lang} title={uiT('404.title', lang)} description={uiT('404.body', lang)} routeKey="home" noindex>
  <Section>
    <h1 class="font-display text-4xl font-bold">{uiT('404.title', lang)}</h1>
    <p class="mt-4 text-gris">{uiT('404.body', lang)}</p>
    <ul class="mt-8 space-y-2">
      {
        links.map((link) => (
          <li>
            <a class="font-semibold text-verde underline" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
