---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Figura from '../components/mdx/Figura.astro';
import Nota from '../components/mdx/Nota.astro';
import type { Lang } from '../i18n/routes';
import { uiT } from '../i18n/ui';
import { getPublishedProyectos, proyectoSlug, getProyectoTexto } from '../lib/content';
import { render } from 'astro:content';
import { localizedPath } from '../i18n/utils';
import JsonLd from '../components/seo/JsonLd.astro';
import { breadcrumbList, creativeWork } from '../lib/schema';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const proyectos = await getPublishedProyectos();
const entry = proyectos.find((p) => proyectoSlug(p) === slug);
if (!entry) return Astro.redirect(localizedPath('proyectos', lang));
const texto = await getProyectoTexto(slug, lang);
if (!texto) return Astro.redirect(localizedPath('proyectos', lang));
const { Content } = await render(texto);
const origin = Astro.site ?? new URL('https://gubiadigital.example');
const pageUrl = new URL(localizedPath('proyecto', lang, { slug }), origin).href;
const indexUrl = new URL(localizedPath('proyectos', lang), origin).href;
const ogPath = `/og/proyectos/${slug}.webp`;
---

<BaseLayout
  lang={lang}
  title={entry.data.nombre}
  description={texto.data.descripcionSeo}
  routeKey="proyecto"
  slug={slug}
  ogImage={ogPath}
  ogWidth={1200}
  ogHeight={630}
>
  <JsonLd
    data={breadcrumbList([
      { name: uiT('nav.proyectos', lang), url: indexUrl },
      { name: entry.data.nombre, url: pageUrl },
    ])}
  />
  <JsonLd
    data={creativeWork({
      name: entry.data.nombre,
      url: pageUrl,
      description: texto.data.descripcionSeo,
      image: new URL(ogPath, origin).href,
    })}
  />
  <Section>
    <p>
      <a class="text-sm font-semibold text-verde underline underline-offset-4" href={indexUrl}>
        {uiT('nav.proyectos', lang)}
      </a>
    </p>
    <div class="proyecto-cuerpo mt-8 space-y-4 [&_a]:font-semibold [&_a]:text-verde [&_a]:underline [&_h1]:max-w-[22ch] [&_h1]:font-display [&_h1]:text-4xl [&_h1]:font-bold [&_h1]:leading-[1.05] md:[&_h1]:text-6xl [&_h2]:mt-12 [&_h2]:max-w-prose [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_p]:max-w-prose [&_p]:text-tinta/90">
      <Content components={{ Figura, Nota }} />
    </div>
  </Section>
</BaseLayout>
