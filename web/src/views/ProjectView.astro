---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import type { Lang } from '../i18n/routes';
import { uiT } from '../i18n/ui';
import {
  getPublishedProyectos,
  proyectoSlug,
  getProyectoTexto,
} from '../lib/content';
import { resolveContentImage } from '../lib/images';
import { render } from 'astro:content';
import { localizedPath } from '../i18n/utils';
import FigureStat from '../components/ui/FigureStat.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { breadcrumbList, creativeWork } from '../lib/schema';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const proyectos = await getPublishedProyectos();
const entry = proyectos.find((p) => proyectoSlug(p) === slug);
if (!entry) return Astro.redirect(localizedPath('proyectos', lang));
const texto = await getProyectoTexto(slug, lang);
if (!texto) return Astro.redirect(localizedPath('proyectos', lang));
const { Content } = await render(texto);
const portada = resolveContentImage('proyectos', slug, entry.data.portada);
const origin = Astro.site ?? new URL('https://gubiadigital.example');
const pageUrl = new URL(localizedPath('proyecto', lang, { slug }), origin).href;
const indexUrl = new URL(localizedPath('proyectos', lang), origin).href;
const ogPath = slug.startsWith('_') ? '/og-default.webp' : `/og/proyectos/${slug}.webp`;
---

<BaseLayout
  lang={lang}
  title={entry.data.nombre}
  description={texto.data.descripcionSeo}
  routeKey="proyecto"
  slug={slug}
  ogImage={ogPath}
  ogWidth={slug.startsWith('_') ? undefined : 1200}
  ogHeight={slug.startsWith('_') ? undefined : 630}
>
  <JsonLd
    data={breadcrumbList([
      { name: uiT('nav.proyectos', lang), url: indexUrl },
      { name: entry.data.nombre, url: pageUrl },
    ])}
  />
  <JsonLd
    data={creativeWork({
      name: entry.data.nombre,
      url: pageUrl,
      description: texto.data.descripcionSeo,
      image: new URL(ogPath, origin).href,
    })}
  />
  <Section>
    <p class="text-sm font-semibold text-verde">{uiT(`estado.${entry.data.estado}`, lang)}</p>
    <h1 class="mt-2 font-display text-4xl font-bold md:text-5xl">{entry.data.nombre}</h1>
    <p class="mt-3 text-lg text-gris">{entry.data.tagline[lang]}</p>
    <p class="mt-2 text-sm text-tinta/80">{entry.data.rol[lang]}</p>

    {
      portada && (
        <img
          src={portada.src}
          alt={entry.data.nombre}
          width={portada.width}
          height={portada.height}
          class="mt-10 w-full rounded-[var(--radius-md)] border border-linea"
        />
      )
    }

    {
      entry.data.cifras && (
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {entry.data.cifras.map((c) => (
            <li>
              <FigureStat valor={c.valor} etiqueta={c.etiqueta[lang]} />
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-12 max-w-prose space-y-4 [&_h2]:mt-8 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold">
      <Content />
    </div>

    {
      (entry.data.enlaces?.web || entry.data.enlaces?.repo) && (
        <ul class="mt-10 space-y-2">
          {entry.data.enlaces?.web && (
            <li>
              <a class="font-semibold text-verde underline" href={entry.data.enlaces.web} rel="noopener">
                {entry.data.enlaces.web}
              </a>
            </li>
          )}
          {entry.data.enlaces?.repo && (
            <li>
              <a class="font-semibold text-verde underline" href={entry.data.enlaces.repo} rel="noopener">
                {lang === 'es' ? 'Código' : 'Code'}
              </a>
            </li>
          )}
        </ul>
      )
    }
  </Section>
</BaseLayout>
